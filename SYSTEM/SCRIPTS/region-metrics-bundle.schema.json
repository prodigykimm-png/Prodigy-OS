{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region-metrics-bundle.schema.json",
  "title": "Region Intelligence Metrics Bundle",
  "description": "Aggregated metrics bundle for a single Region, combining population, market, supply, and employment data from multiple providers with trust and freshness metadata.",
  "type": "object",
  "required": [
    "region_key",
    "lawd_code",
    "household_code",
    "as_of",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "region_key": {
      "type": "string",
      "minLength": 1
    },
    "lawd_code": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "household_code": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "$ref": "#/$defs/metric_section"
        },
        "market": {
          "$ref": "#/$defs/metric_section"
        },
        "supply": {
          "$ref": "#/$defs/metric_section"
        },
        "employment": {
          "$ref": "#/$defs/metric_section"
        },
        "land_price": {
          "$ref": "#/$defs/metric_section"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "unavailable"
          ]
        },
        "coverage": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "blocked"
          ]
        },
        "schema_valid": {
          "type": "boolean"
        },
        "source_verified": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "metric_section": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "populated",
            "empty",
            "stale",
            "blocked",
            "unavailable"
          ]
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "object"
        },
        "yoy_change": {
          "type": "object"
        },
        "source_receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
