{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_blocks",
    "knowledge_candidates",
    "resource_candidates",
    "object_linking_suggestions",
    "pre_routing_suggestions",
    "uncertainties"
  ],
  "properties": {
    "evidence_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "context", "experience", "interpretation", "change", "next_experiment", "related_objects"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "context": {
            "type": "string",
            "enum": ["", "people", "auction", "workout", "reading", "project", "work", "personal", "health", "decision", "integrity"]
          },
          "experience": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "interpretation": { "type": "string", "maxLength": 1000 },
          "change": { "type": "string", "maxLength": 1000 },
          "next_experiment": { "type": "string", "maxLength": 1000 },
          "related_objects": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
        }
      }
    },
    "knowledge_candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail", "source_evidence_indexes", "confidence"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "detail": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "source_evidence_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
              "confidence": { "type": "string", "enum": ["explicit", "inferred", "low"] },
              "suggested_domain": { "type": "string", "enum": ["", "real_estate", "wedding", "coding", "workout", "reading", "business", "personal_growth"] },
              "suggested_topics": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "source_evidence_indexes", "confidence"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 500 },
              "source_evidence_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
              "confidence": { "type": "string", "enum": ["explicit", "inferred", "low"] },
              "suggested_domain": { "type": "string", "enum": ["", "real_estate", "wedding", "coding", "workout", "reading", "business", "personal_growth"] },
              "suggested_topics": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
            }
          }
        ]
      }
    },
    "resource_candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "suggested_type", "source_evidence_indexes"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "suggested_type": { "type": "string", "enum": ["resource", "venue"] },
          "source_evidence_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "object_linking_suggestions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "object_kind", "source_evidence_indexes", "existence"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "object_kind": { "type": "string", "minLength": 1, "maxLength": 80 },
          "source_evidence_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "existence": { "type": "string", "const": "unknown" }
        }
      }
    },
    "pre_routing_suggestions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_evidence_indexes", "path", "confidence"],
        "properties": {
          "source_evidence_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "path": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "confidence": { "type": "string", "enum": ["explicit", "inferred", "low"] }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
