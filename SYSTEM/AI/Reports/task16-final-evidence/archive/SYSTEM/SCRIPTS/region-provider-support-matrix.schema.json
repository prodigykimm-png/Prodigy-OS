{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodigy-os.local/schema/region-provider-support-matrix-v1.json",
  "title": "Prodigy Region Provider Support Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "matrix_id", "as_of", "providers"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "matrix_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "as_of": { "type": "string", "format": "date" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id", "provider_contract_id", "source_kind", "source_url", "official_available",
          "adapter_ready", "fixture_ready", "network_allowed", "projection_ready", "status",
          "geography_levels", "property_types", "blocked_reason"
        ],
        "properties": {
          "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
          "provider_contract_id": { "type": ["string", "null"] },
          "source_kind": { "const": "official" },
          "source_url": { "type": "string", "pattern": "^https://" },
          "official_available": { "type": "boolean" },
          "adapter_ready": { "type": "boolean" },
          "fixture_ready": { "type": "boolean" },
          "network_allowed": { "type": "boolean" },
          "projection_ready": { "type": "boolean" },
          "status": { "enum": ["pilot_ready", "blocked_coverage", "blocked_fixture", "disabled"] },
          "geography_levels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "property_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "blocked_reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
