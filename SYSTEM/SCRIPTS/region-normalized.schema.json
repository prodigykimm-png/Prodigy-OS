{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region-normalized.schema.json",
  "title": "Region Intelligence Normalized Rows",
  "description": "Normalized data rows extracted from raw provider responses. Each row is bound to an exact canonical Region identity and carries typed measures with units.",
  "type": "object",
  "required": [
    "provider_id",
    "run_id",
    "period",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region_key",
          "lawd_code",
          "household_code",
          "measures"
        ],
        "additionalProperties": false,
        "properties": {
          "region_key": {
            "type": "string",
            "minLength": 1
          },
          "lawd_code": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "household_code": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "measures": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "quarantined": {
            "type": "boolean"
          },
          "quarantine_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
