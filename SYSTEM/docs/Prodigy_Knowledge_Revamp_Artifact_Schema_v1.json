{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodigy-os.local/schemas/prodigy-knowledge-revamp-artifacts-v1.json",
  "title": "Prodigy Knowledge Revamp Artifact Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": {
      "enum": ["manifest", "placement_decisions", "proposal", "integration_memo", "gate_receipt", "walkthrough", "improvement_catalog", "citation_checks", "exclusions", "execution_scope"]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact_type": { "const": "manifest" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/manifest" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "placement_decisions" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/placementDecisions" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "proposal" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/proposal" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "walkthrough" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/walkthrough" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "improvement_catalog" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/improvementCatalog" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "citation_checks" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/citationChecks" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "exclusions" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/exclusions" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "execution_scope" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/executionScope" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "integration_memo" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/integrationMemo" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "gate_receipt" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/gateReceipt" } } }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "ref", "path", "symbol", "line_start", "line_end", "claim"],
      "properties": {
        "citation_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^[^/].*" },
        "symbol": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "manifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "schema_version", "source_refs", "sha256", "owner", "dependencies", "lifecycle", "validation_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "path": { "type": "string", "pattern": "^[^/].*" },
        "schema_version": { "const": "1.0" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "owner": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "lifecycle": { "enum": ["complete", "deferred", "implementation_gate_required"] },
        "validation_status": { "enum": ["valid", "not_created", "pending", "invalid"] },
        "activation_gate": { "type": ["string", "null"] },
        "deferred_reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "lifecycle": { "const": "complete" } } },
          "then": {
            "properties": {
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "validation_status": { "const": "valid" }
            }
          }
        },
        {
          "if": { "properties": { "lifecycle": { "const": "deferred" } } },
          "then": {
            "required": ["activation_gate", "deferred_reason"],
            "properties": {
              "sha256": { "type": "null" },
              "validation_status": { "const": "not_created" },
              "activation_gate": { "const": "implementation_gate" },
              "deferred_reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "schema_version", "artifact_type", "lifecycle", "entries", "validation_status"],
      "properties": {
        "manifest_id": { "const": "prodigy-knowledge-revamp" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "manifest" },
        "lifecycle": { "const": "complete" },
        "entries": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/manifestEntry" } },
        "validation_status": { "const": "valid" }
      }
    },
    "placementDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "decision_id", "recommendation", "requested_option", "user_choice", "decision_status", "selectable", "requirements_renegotiation_required", "blocking_wps", "owner", "rationale", "citation_ids"],
      "properties": {
        "fixture_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "decision_id": { "const": "wiki_placement" },
        "recommendation": { "enum": ["fourth_tab", "embedded_region"] },
        "requested_option": { "enum": ["fourth_tab", "embedded_region", "standalone_workspace", null] },
        "user_choice": { "enum": ["fourth_tab", "embedded_region", null] },
        "decision_status": { "enum": ["awaiting_user", "accepted", "rejected", "requirements_renegotiation_required"] },
        "selectable": { "type": "boolean" },
        "requirements_renegotiation_required": { "type": "boolean" },
        "blocking_wps": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^WP[0-9]+$" } },
        "owner": { "const": "user" },
        "rationale": { "type": "string", "minLength": 1 },
        "citation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "decision_status": { "const": "accepted" } } },
          "then": {
            "properties": {
              "user_choice": { "enum": ["fourth_tab", "embedded_region"] },
              "selectable": { "const": true },
              "requirements_renegotiation_required": { "const": false },
              "blocking_wps": { "not": { "contains": { "const": "WP1" } } }
            }
          }
        },
        {
          "if": { "properties": { "decision_status": { "const": "awaiting_user" } } },
          "then": {
            "properties": {
              "user_choice": { "type": "null" },
              "selectable": { "const": true },
              "requirements_renegotiation_required": { "const": false },
              "blocking_wps": { "contains": { "const": "WP1" } }
            }
          }
        },
        {
          "if": { "properties": { "requested_option": { "const": "standalone_workspace" } } },
          "then": {
            "properties": {
              "user_choice": { "type": "null" },
              "decision_status": { "const": "requirements_renegotiation_required" },
              "selectable": { "const": false },
              "requirements_renegotiation_required": { "const": true },
              "blocking_wps": { "contains": { "const": "WP1" } }
            }
          }
        },
        {
          "if": { "properties": { "decision_status": { "const": "requirements_renegotiation_required" } } },
          "then": {
            "properties": {
              "requested_option": { "const": "standalone_workspace" },
              "user_choice": { "type": "null" },
              "selectable": { "const": false },
              "requirements_renegotiation_required": { "const": true },
              "blocking_wps": { "contains": { "const": "WP1" } }
            }
          }
        }
      ]
    },
    "placementDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions"],
      "properties": {
        "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/placementDecision" } }
      }
    },
    "proposalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "current_screen", "citation_ids", "observed_steps", "observed_count", "proposed_steps", "proposed_count", "proposed_change", "expected_effect", "priority", "gate_disposition", "owner", "dependencies", "decision_status", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "current_screen": { "type": "string", "minLength": 1 },
        "citation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "observed_steps": { "type": "array", "items": { "type": "string" } },
        "observed_count": { "type": "integer", "minimum": 0 },
        "proposed_steps": { "type": "array", "items": { "type": "string" } },
        "proposed_count": { "type": "integer", "minimum": 0 },
        "proposed_change": { "type": "string", "minLength": 1 },
        "expected_effect": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "gate_disposition": { "enum": ["preserve", "review_required", "out_of_scope"] },
        "owner": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "decision_status": { "enum": ["proposed", "accepted", "deferred", "rejected"] },
        "status": { "enum": ["draft", "ready", "blocked", "complete"] }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "schema_version", "artifact_type", "scope", "citations", "items", "exclusions"],
      "properties": {
        "proposal_id": { "const": "prodigy-knowledge-revamp-proposal" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "proposal" },
        "scope": { "const": "user-facing-surfaces" },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proposalItem" } },
        "exclusions": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "reason", "decision_status", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "scope": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "decision_status": { "enum": ["out_of_scope", "deferred", "rejected"] },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "walkthroughStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "screen_id", "state", "visible_controls", "action", "delta", "cumulative", "citation_ids", "annotation"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "screen_id": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "visible_controls": { "type": "array", "items": { "type": "string" } },
        "action": { "type": "string", "minLength": 1 },
        "delta": { "type": "integer", "minimum": 0 },
        "cumulative": { "type": "integer", "minimum": 0 },
        "citation_ids": { "type": "array", "items": { "type": "string" } },
        "annotation": { "type": "string", "minLength": 1 }
      }
    },
    "walkthroughRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "trigger", "steps", "citation_ids", "gate_disposition"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "citation_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "gate_disposition": { "enum": ["preserve", "review_required", "out_of_scope"] }
      }
    },
    "walkthroughRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "before", "after", "single_screen", "single_screen_citation_ids", "workspace_switches", "keyboard_equivalent", "steps", "current_total_actions", "proposed_total_actions", "action_budget", "recovery_route", "citation_ids", "owner", "dependencies", "priority", "gate_disposition", "decision_status", "status"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "before": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "after": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "single_screen": { "type": "boolean" },
        "single_screen_citation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "workspace_switches": { "type": "integer", "minimum": 0 },
        "keyboard_equivalent": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/walkthroughStep" } },
        "current_total_actions": { "type": "integer", "minimum": 0 },
        "proposed_total_actions": { "type": "integer", "minimum": 0 },
        "action_budget": { "type": "integer", "minimum": 0 },
        "recovery_route": { "$ref": "#/$defs/walkthroughRecovery" },
        "citation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "owner": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "gate_disposition": { "enum": ["preserve", "review_required", "out_of_scope"] },
        "decision_status": { "enum": ["proposed", "accepted", "deferred", "rejected"] },
        "status": { "enum": ["draft", "ready", "blocked", "complete"] }
      }
    },
    "walkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walkthrough_id", "schema_version", "artifact_type", "scope", "counting_rules", "citations", "routes", "status"],
      "properties": {
        "walkthrough_id": { "const": "prodigy-knowledge-workspace-walkthrough" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "walkthrough" },
        "scope": { "const": "knowledge-workspace" },
        "counting_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } },
        "routes": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/walkthroughRoute" } },
        "status": { "enum": ["ready", "blocked", "deferred"] }
      }
    },
    "catalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "citation_ids", "observed_problem", "expected_effect", "priority", "owner", "dependencies", "gate_disposition", "decision_status", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "surface": { "type": "string", "minLength": 1 },
        "citation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "observed_problem": { "type": "string", "minLength": 1 },
        "expected_effect": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "owner": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "gate_disposition": { "enum": ["preserve", "review_required", "out_of_scope"] },
        "decision_status": { "enum": ["proposed", "accepted", "deferred", "rejected"] },
        "status": { "enum": ["draft", "ready", "blocked", "complete"] }
      }
    },
    "improvementCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "schema_version", "artifact_type", "scope", "citations", "items", "exclusion_ids", "status"],
      "properties": {
        "catalog_id": { "const": "prodigy-user-surface-improvement-catalog" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "improvement_catalog" },
        "scope": { "const": "user-facing-surfaces" },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/catalogItem" } },
        "exclusion_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": { "enum": ["ready", "blocked", "deferred"] }
      }
    },
    "citationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "excerpt_ref", "excerpt_hash", "verifier", "status", "disposition"],
      "properties": {
        "citation_id": { "type": "string", "minLength": 1 },
        "excerpt_ref": { "type": "string", "minLength": 1 },
        "excerpt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verifier": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "failed", "unverified"] },
        "disposition": { "enum": ["keep", "revise", "remove"] }
      }
    },
    "citationChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks_id", "schema_version", "artifact_type", "checks", "status"],
      "properties": {
        "checks_id": { "const": "prodigy-knowledge-revamp-citation-checks" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "citation_checks" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citationCheck" } },
        "status": { "enum": ["ready", "blocked", "deferred"] }
      }
    },
    "exclusionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "reason", "scope_rule", "owner", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "surface": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "scope_rule": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["explicit", "accepted", "deferred"] }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusions_id", "schema_version", "artifact_type", "items", "status"],
      "properties": {
        "exclusions_id": { "const": "prodigy-knowledge-revamp-exclusions" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "exclusions" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exclusionItem" } },
        "status": { "enum": ["ready", "blocked", "deferred"] }
      }
    },
    "executionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "schema_version", "artifact_type", "source_brief", "approved_plan", "authorization", "stories", "constraints", "status"],
      "properties": {
        "scope_id": { "const": "prodigy-knowledge-revamp-execution-scope" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "execution_scope" },
        "source_brief": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "seed_scope", "constraints_preserved"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "seed_scope": { "const": "WP0 kickoff seed" },
            "constraints_preserved": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "approved_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidence"],
          "properties": {
            "kind": { "const": "user_directive" },
            "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^G[0-9]{3}$" },
              "title": { "type": "string", "minLength": 1 },
              "status": { "enum": ["complete", "blocked", "pending"] }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placement", "f11", "approval_flow", "branch_refs", "legacy_candidates"],
          "properties": {
            "placement": { "const": "fourth_tab_or_embedded_region_only_until_user_choice" },
            "f11": { "const": "standalone_requires_renegotiation_and_replan" },
            "approval_flow": { "const": "preserve_evidence_human_review_knowledge_approval" },
            "branch_refs": { "const": "do_not_mutate" },
            "legacy_candidates": { "const": "readable_approvable_without_migration" }
          }
        },
        "status": { "const": "accepted" }
      }
    },
    "integrationMemo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memo_id", "schema_version", "artifact_type", "status", "refs", "merge_base", "selected_baseline", "strategy", "collisions", "baseline_evidence", "approver", "approval_condition", "approval_evidence"],
      "properties": {
        "memo_id": { "const": "prodigy-knowledge-revamp-integration" },
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "integration_memo" },
        "status": { "enum": ["implementation_gate_required", "accepted"] },
        "refs": { "type": "object" },
        "merge_base": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "selected_baseline": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["no_merge_design_only", "fast_forward", "rebase", "merge", "file_reconciliation"] },
        "collisions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "baseline_evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "approver": { "type": "string", "minLength": 1 },
        "approval_condition": { "type": "string", "minLength": 1 },
        "approval_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "gateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "wp", "baseline_sha", "test_ids", "fixture_hashes", "counters", "authorization_count", "commit_count", "result", "timestamp"],
      "properties": {
        "gate_id": { "type": "string" },
        "wp": { "type": "string", "pattern": "^WP[0-9]+$" },
        "baseline_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "test_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fixture_hashes": { "type": "array", "items": { "type": "string" } },
        "counters": { "type": "object" },
        "authorization_count": { "type": "integer", "minimum": 0 },
        "commit_count": { "type": "integer", "minimum": 0 },
        "result": { "enum": ["passed", "failed", "blocked"] },
        "timestamp": { "type": "string", "minLength": 1 }
      }
    }
  }
}
