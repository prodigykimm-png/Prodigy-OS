{
  "schema_version": 1,
  "skill_name": "llmwiki-librarian",
  "service_boundary": "local_llm_wiki",
  "confidence_labels": ["explicit", "inferred", "low"],
  "proposal_kinds": ["create", "update", "merge", "dispute", "abstain", "no_change"],
  "proposal_statuses": ["proposed", "approved", "rejected", "stale", "abstain", "no_change"],
  "trust_vocab": ["source_text_untrusted", "human_approval_required", "deterministic_commit_only"],
  "provider_modes": ["direct", "omniroute"],
  "omniroute_scope": "feature_selectable",
  "canonical_promotion": "user_approved_deterministic_commit_only",
  "draft_preservation": "explicit_para_or_zeta_capture_only",
  "source_text_authority": "untrusted_data_only",
  "required_packet_fields": [
    "run_id",
    "proposal_id",
    "payload_hash",
    "status",
    "kind",
    "citations",
    "locators",
    "confidence",
    "entity_links",
    "theme_links",
    "material_links",
    "graph",
    "lint",
    "contradictions",
    "approval",
    "refusals"
  ],
  "write_policy": {
    "query/read": {
      "canonical_write_allowed": false,
      "persistent_write_allowed": false
    },
    "propose": {
      "canonical_write_allowed": false,
      "persistent_write_allowed": false
    },
    "approve": {
      "canonical_write_allowed": true,
      "persistent_write_allowed": true,
      "requires": ["human_approval", "deterministic_writer", "payload_hash_match", "current_revision_match"]
    }
  },
  "forbidden_side_effects": [
    "direct_canonical_markdown_write",
    "hidden_query_mutation",
    "automatic_candidate_write",
    "automatic_knowledge_write",
    "automatic_object_write",
    "automatic_people_write",
    "automatic_venue_write",
    "git_stage_commit_push",
    "provider_hop",
    "model_output_approval"
  ],
  "locator_policy": {
    "relative_only": true,
    "forbid_absolute_paths": true,
    "forbid_parent_segments": true,
    "forbid_control_characters": true,
    "require_fragment_or_line_locator": true
  }
}
