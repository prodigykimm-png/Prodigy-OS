{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodigy-os.local/schema/prodigy-mobile-settings-change-v1.json",
  "title": "Prodigy Mobile Settings Change Evidence",
  "description": "Strict, redacted evidence for one approved, reversible comparison of a frozen Obsidian mobile settings source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "change_id",
    "target_path",
    "configuration_id",
    "campaign_id",
    "json_pointer",
    "structural_anchor",
    "preimage_sha256",
    "preimage_bytes",
    "before",
    "after",
    "proposed_postimage_sha256",
    "backup_path",
    "backup_sha256",
    "backup_bytes",
    "backup_read_back",
    "identity",
    "dependency",
    "user_purpose",
    "approval",
    "diff",
    "rollback",
    "observed_impact"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "obsidian-settings-change" },
    "change_id": { "$ref": "#/$defs/id" },
    "target_path": { "enum": [".obsidian/community-plugins.json", ".obsidian/workspace-mobile.json"] },
    "configuration_id": { "$ref": "#/$defs/id" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "configuration_digest": { "$ref": "#/$defs/sha256" },
    "campaign_digest": { "$ref": "#/$defs/sha256" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "campaign_sha256": { "$ref": "#/$defs/sha256" },
    "json_pointer": { "$ref": "#/$defs/jsonPointer" },
    "structural_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "identity"],
      "properties": {
        "kind": { "enum": ["plugin", "mobile_leaf"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "preimage_sha256": { "$ref": "#/$defs/sha256" },
    "preimage_bytes": { "$ref": "#/$defs/bytes" },
    "before": { "$ref": "#/$defs/redactedProjection" },
    "after": { "$ref": "#/$defs/redactedProjection" },
    "proposed_postimage_sha256": { "$ref": "#/$defs/sha256" },
    "postimage_sha256": { "$ref": "#/$defs/sha256" },
    "postimage_bytes": { "$ref": "#/$defs/bytes" },
    "backup_path": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
      "minLength": 2,
      "maxLength": 4096
    },
    "backup_sha256": { "$ref": "#/$defs/sha256" },
    "backup_bytes": { "$ref": "#/$defs/bytes" },
    "backup_read_back": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "matches_backup", "verified"],
      "properties": {
        "path": { "type": "string", "minLength": 2, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/bytes" },
        "matches_backup": { "const": true },
        "verified": { "const": true }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "leaf_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "plugin": { "type": "object", "additionalProperties": true },
        "leaf": { "type": "object", "additionalProperties": true }
      },
      "minProperties": 1
    },
    "dependency": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      ]
    },
    "user_purpose": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_by", "approved_at", "evidence", "preimage_sha256", "proposed_postimage_sha256"],
      "properties": {
        "approved": { "const": true },
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "approved_at": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            { "type": "object", "additionalProperties": true },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "change_id": { "$ref": "#/$defs/id" },
        "target_path": { "enum": [".obsidian/community-plugins.json", ".obsidian/workspace-mobile.json"] },
        "preimage_sha256": { "$ref": "#/$defs/sha256" },
        "proposed_postimage_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable_count", "ambiguous", "changes"],
      "properties": {
        "variable_count": { "const": 1 },
        "ambiguous": { "const": false },
        "path": { "$ref": "#/$defs/jsonPointer" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation", "before", "after"],
            "properties": {
              "path": { "$ref": "#/$defs/jsonPointer" },
              "operation": { "enum": ["add", "replace"] },
              "before": {},
              "after": {},
              "ambiguous": { "const": false },
              "variable_count": { "const": 1 }
            }
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected_sha256", "actual_sha256", "hash_equal", "verified"],
      "properties": {
        "status": { "const": "verified" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "actual_sha256": { "$ref": "#/$defs/sha256" },
        "hash_equal": { "const": true },
        "verified": { "const": true },
        "configuration_id": { "$ref": "#/$defs/id" },
        "campaign_id": { "$ref": "#/$defs/id" }
      }
    },
    "observed_impact": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["physical_mobile_claimed"] },
        { "required": ["physical_evidence_claimed"] },
        { "required": ["physical_mobile_status"] },
        { "required": ["physical_claim_status"] },
        { "required": ["physical_device_success"] }
      ],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/id" },
        "campaign_id": { "$ref": "#/$defs/id" },
        "physical_mobile_claimed": { "const": false },
        "physical_evidence_claimed": { "const": false },
        "physical_mobile_status": { "enum": ["unclaimed", "not_claimed", "not_observed", "unsupported"] },
        "physical_claim_status": { "enum": ["not_proven", "not_claimed", "not_observed", "unsupported"] },
        "physical_device_success": { "const": false },
        "baseline": { "type": "object", "additionalProperties": true },
        "settings": { "type": "object", "additionalProperties": true },
        "product": { "type": "object", "additionalProperties": true }
      }
    },
    "created_at": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "type": "string", "minLength": 1, "maxLength": 512 },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["redacted", "verified"] },
        "ruleset": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "notes": { "type": "string", "maxLength": 4096 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes": { "type": "integer", "minimum": 0 },
    "jsonPointer": { "type": "string", "pattern": "^(?:|(?:\\/(?:[^~]|~[01])*))+$" },
    "redactedProjection": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1
    }
  }
}
