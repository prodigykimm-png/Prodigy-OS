{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region-receipt.schema.json",
  "title": "Region Intelligence Collection Receipt",
  "description": "Terminal receipt for a provider generation. A successful receipt means collected|unchanged, never applied. Immutable and hash-addressed.",
  "type": "object",
  "required": [
    "provider_id",
    "run_id",
    "generation_id",
    "status",
    "fetched_at",
    "raw_sha256",
    "normalized_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "collected",
        "unchanged",
        "failed",
        "blocked_auth",
        "blocked_schema",
        "blocked_coverage",
        "blocked_runtime"
      ]
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "diff_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_revision": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_regions": {
          "type": "integer"
        },
        "covered_regions": {
          "type": "integer"
        },
        "quarantined_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
